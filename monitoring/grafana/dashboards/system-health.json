{
  "dashboard": {
    "title": "Cerberus AI — System Health",
    "tags": ["cerberus", "health", "infrastructure"],
    "timezone": "browser",
    "refresh": "10s",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "CPU Usage (%)",
        "type": "gauge",
        "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
        "targets": [{ "expr": "system_cpu_usage_percent" }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 70, "color": "yellow" }, { "value": 90, "color": "red" }] }
          }
        }
      },
      {
        "id": 2,
        "title": "Memory Usage (%)",
        "type": "gauge",
        "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
        "targets": [{ "expr": "system_memory_usage_percent" }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 75, "color": "yellow" }, { "value": 90, "color": "red" }] }
          }
        }
      },
      {
        "id": 3,
        "title": "Disk Usage (%)",
        "type": "gauge",
        "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
        "targets": [{ "expr": "system_disk_usage_percent" }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 80, "color": "yellow" }, { "value": 95, "color": "red" }] }
          }
        }
      },
      {
        "id": 4,
        "title": "DB Connections",
        "type": "gauge",
        "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
        "targets": [{ "expr": "pg_stat_activity_count" }],
        "fieldConfig": {
          "defaults": {
            "max": 100,
            "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 50, "color": "yellow" }, { "value": 80, "color": "red" }] }
          }
        }
      },
      {
        "id": 5,
        "title": "CPU Over Time",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
        "targets": [{ "expr": "system_cpu_usage_percent", "legendFormat": "CPU %" }]
      },
      {
        "id": 6,
        "title": "Memory Over Time",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
        "targets": [{ "expr": "system_memory_usage_percent", "legendFormat": "Memory %" }]
      },
      {
        "id": 7,
        "title": "Service Status",
        "type": "table",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
        "targets": [
          { "expr": "up{job='cerberus-backend'}", "legendFormat": "Backend" },
          { "expr": "up{job='cerberus-postgres'}", "legendFormat": "PostgreSQL" },
          { "expr": "up{job='cerberus-redis'}", "legendFormat": "Redis" },
          { "expr": "up{job='cerberus-frontend'}", "legendFormat": "Frontend" }
        ]
      },
      {
        "id": 8,
        "title": "Redis Memory",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
        "targets": [{ "expr": "redis_memory_used_bytes", "legendFormat": "Used" }]
      },
      {
        "id": 9,
        "title": "Uptime",
        "type": "stat",
        "gridPos": { "h": 4, "w": 12, "x": 12, "y": 22 },
        "targets": [{ "expr": "time() - process_start_time_seconds" }],
        "fieldConfig": { "defaults": { "unit": "s" } }
      }
    ]
  }
}
