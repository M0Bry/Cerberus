# ─── Application ─────────────────────────────────────────────
APP_NAME=Cerberus AI
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# ─── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cerberus:cerberus_secret@postgres:5432/cerberus
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://:cerberus_redis@redis:6379/0
REDIS_PASSWORD=cerberus_redis

# ─── Security ────────────────────────────────────────────────
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_ME_WITH_A_RANDOM_64_CHAR_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@cerberus-ai.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_NAME=Cerberus AI
SMTP_FROM_EMAIL=noreply@cerberus-ai.com

# ─── AI / OpenAI ─────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo
OPENAI_MAX_TOKENS=4096

# ─── Celery ──────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:cerberus_redis@redis:6379/1
CELERY_RESULT_BACKEND=redis://:cerberus_redis@redis:6379/2

# ─── File Uploads ────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=[".pdf",".docx",".xlsx",".txt",".csv",".json",".xml",".zip"]

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=5

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
