# ══════════════════════════════════════════════════════════════════════
# Cerberus AI — backend environment (copy to `.env` and edit)
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/macOS:           cp .env.example .env
#
# Only three things are strictly required for a local run:
#   1. SECRET_KEY      — 32+ random chars, or the app refuses to start
#   2. DATABASE_URL    — must point at a reachable Postgres with role/DB
#   3. Postgres        — role + database created (see RUNNING.md)
#
# Everything else below already has working defaults (the values shown are
# the tested local configuration).
# ══════════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────────
APP_NAME=Cerberus AI
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ── Database ───────────────────────────────────────────────────────────
# Create the role + DB first (see RUNNING.md):
#   CREATE ROLE cerberus LOGIN PASSWORD 'cerberus_secret';
#   CREATE DATABASE cerberus OWNER cerberus;
DATABASE_URL=postgresql+asyncpg://cerberus:cerberus_secret@localhost:5432/cerberus
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis (optional — the app runs without it; defense state stays
#    in-process) ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ── Security (REQUIRED) ────────────────────────────────────────────────
# Generate one:
#   PowerShell:  -join ((48..57)+(97..122) | Get-Random -Count 64 | % {[char]$_})
#   Linux/macOS: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_ME_WITH_A_RANDOM_64_CHAR_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_SECONDS=90
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
TRIAL_DAYS=7
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Email ──────────────────────────────────────────────────────────────
# Leave SMTP_USER + SMTP_FROM_EMAIL EMPTY for local development:
# the app then uses the console provider and prints every OTP to the
# API terminal — perfect for testing without a mail account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Cerberus AI
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# auto = SMTP when configured, console otherwise
EMAIL_PROVIDER=auto
SENDGRID_API_KEY=
SENDGRID_API_URL=https://api.sendgrid.com

# ── Payments (Stripe — test mode) ──────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test
STRIPE_BASE_URL=https://api.stripe.com
FRONTEND_BASE_URL=http://localhost:3000

# ── AI engine ──────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo
OPENAI_MAX_TOKENS=4096

# ── Task queue (optional, same as Redis) ───────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=[".pdf",".docx",".xlsx",".txt",".csv",".json",".xml",".zip"]

# ── Rate limiting ──────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=5

# ── Defense / Tier 1-3 (tested local values) ───────────────────────────
DEFENSE_ENABLED=true
DEFENSE_RATE_LIMIT=100
DEFENSE_RATE_WINDOW=60
DEFENSE_EXCLUDED_PATHS=["/docs","/redoc","/openapi.json","/health","/api/v1/health","/favicon.ico"]
# If you run behind a reverse proxy, add its CIDRs here (e.g. 127.0.0.1/32)
TRUSTED_PROXY_CIDRS=
DEFENSE_MAX_BODY_BYTES=262144
DEFENSE_MAX_BODY_AUTH_BYTES=8192

# Cost-aware email limits (per hour)
COST_WINDOW_SECONDS=3600
COST_REGISTER_PER_EMAIL=3
COST_REGISTER_PER_IP=10
COST_RESEND_PER_EMAIL=3
COST_RESEND_PER_IP=10
COST_CONTACT_PER_EMAIL=2
COST_CONTACT_PER_IP=5

# Prompt-injection guard (AI input)
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_BLOCK_FAMILIES=2

# Session lifecycle (Tier 2, Part D)
SESSION_REGISTRY_ENABLED=true
SESSION_MAX_ACTIVE=5

# Per-user limits (Tier 2, Part D)
DEFENSE_USER_LIMITS_ENABLED=true
DEFENSE_USER_RATE_LIMIT=120
DEFENSE_USER_RATE_WINDOW=60
DEFENSE_REFRESH_RATE_LIMIT=10

# Durable alert persistence (Tier 2, Part D)
ALERT_PERSISTENCE_ENABLED=true
ALERT_PERSISTENCE_INTERVAL_SECONDS=5

# Advanced validation (LLM scoring) — off by default
ADVANCED_VALIDATION_ENABLED=false
ADVANCED_VALIDATION_THRESHOLD=30

# Anomaly detector
DEFENSE_ANOMALY_CONTAMINATION=0.1
DEFENSE_ANOMALY_N_ESTIMATORS=100
DEFENSE_ANOMALY_MODEL_PATH=storage/models/anomaly_detector.pkl
DEFENSE_ANOMALY_MIN_SAMPLES=50

# Tier 3 (agent-owned module)
DEFENSE_TIER3_ENABLED=true
DEFENSE_BLOCK_THRESHOLD=0.8
DEFENSE_LLM_PROVIDER=openai
DEFENSE_LLM_MODEL=gpt-4-turbo
DEFENSE_LLM_MAX_TOKENS=2048
DEFENSE_LLM_TEMPERATURE=0.2

# Abuse detection (brute-force / 403 flood)
ABUSE_MAX_FAILED_LOGINS=5
ABUSE_FAILED_LOGIN_WINDOW=300
ABUSE_MAX_403_ERRORS=10
ABUSE_FORBIDDEN_WINDOW=600
ABUSE_BLOCK_DURATION=3600

# Defense logging
IP_LOGGER_MAX_HISTORY=100
IP_LOGGER_TTL=86400
INCIDENT_MAX_HISTORY=100
INCIDENT_TTL=604800

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_METRICS_PATH=/metrics

# ── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
